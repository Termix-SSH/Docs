{
  "openapi": "3.0.3",
  "info": {
    "title": "Web Servers API",
    "version": "1.0.0",
    "description": "Manage nginx, Apache and Caddy on your hosts: sites, config, logs and HTTPS, with every change tested first."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/web-servers/summary": {
      "get": {
        "summary": "Web servers on every host",
        "description": "One entry per host with Web Servers turned on, with each installed server, its state and how many sites it has. Kept for a minute unless refresh=1.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "refresh",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One entry per host."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/status": {
      "get": {
        "summary": "Web servers on a host",
        "description": "Which of nginx, Apache and Caddy are installed, their versions and state, certbot, php-fpm sockets and whether the caller gets alerts for this host.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The status."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/sites": {
      "get": {
        "summary": "Every site",
        "description": "The site files of each installed server with their domains, ports, web root or app, HTTPS and certificate expiry.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The sites."
          }
        }
      },
      "post": {
        "summary": "Add a site",
        "description": "Send spec to build the config from the site form, or content for your own text. The whole config is tested first and the server is reloaded only when the test passes.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "server",
                  "name"
                ],
                "properties": {
                  "server": {
                    "type": "string",
                    "enum": [
                      "nginx",
                      "apache",
                      "caddy"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "spec": {
                    "type": "object"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The end of the test output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/sites/preview": {
      "post": {
        "summary": "Show the config a site form makes",
        "description": "Nothing is saved.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "server",
                  "name",
                  "spec"
                ],
                "properties": {
                  "server": {
                    "type": "string",
                    "enum": [
                      "nginx",
                      "apache",
                      "caddy"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "spec": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The config text."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/sites/{server}/{name}": {
      "get": {
        "summary": "One site's file",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "server",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The path, text and site form values when it was made in Termix."
          }
        }
      },
      "put": {
        "summary": "Change a site",
        "description": "Send spec or content, like when adding one. A broken config is put back and the server keeps running the old one.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "server",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "spec": {
                    "type": "object"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The end of the test output."
          }
        }
      },
      "delete": {
        "summary": "Delete a site",
        "description": "The file is kept as a backup in /var/lib/termix-web-servers/backups.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "server",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The end of the test output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/sites/{server}/{name}/enable": {
      "post": {
        "summary": "Turn a site on",
        "description": "Links it into sites-enabled, or drops the .disabled ending. Tested before the reload.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "server",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The end of the test output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/sites/{server}/{name}/disable": {
      "post": {
        "summary": "Turn a site off",
        "description": "Removes its link from sites-enabled, or adds a .disabled ending. The file stays.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "server",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The end of the test output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/sites/{server}/{name}/certificate": {
      "post": {
        "summary": "Get a Let's Encrypt certificate for a site",
        "description": "Runs certbot with its nginx or Apache plugin for the site's domains and reloads the server when the certificate renews. A site made in the site form switches to HTTPS with it.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "server",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "staging": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The end of certbot's output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/files": {
      "get": {
        "summary": "Config files of a server",
        "description": "Every file under the server's folder in /etc.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "server",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paths with their size."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/file": {
      "get": {
        "summary": "Read a config file",
        "description": "Only files under the server's folder. Lists the backups Termix kept of it too.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "server",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The text and backups."
          }
        }
      },
      "put": {
        "summary": "Save a config file",
        "description": "Saves the text, or a backup when backup is set, then tests the whole config. A broken config is put back.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "server",
                  "path"
                ],
                "properties": {
                  "server": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "backup": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The end of the test output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/test": {
      "post": {
        "summary": "Test a server's config",
        "description": "Runs nginx -t, apachectl -t or caddy validate. Changes nothing.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "server"
                ],
                "properties": {
                  "server": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Whether it passed, with the output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/service": {
      "post": {
        "summary": "Start, stop, restart or reload a server",
        "description": "enable and disable choose whether it starts at boot. Start, restart and reload test the config first.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "server",
                  "action"
                ],
                "properties": {
                  "server": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "start",
                      "stop",
                      "restart",
                      "reload",
                      "enable",
                      "disable"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The service manager's output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/install": {
      "post": {
        "summary": "Install a web server",
        "description": "Uses the host's package manager and starts it at boot.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "server"
                ],
                "properties": {
                  "server": {
                    "type": "string",
                    "enum": [
                      "nginx",
                      "apache",
                      "caddy"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The end of the package manager's output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/install-certbot": {
      "post": {
        "summary": "Install certbot",
        "description": "With its plugin for each installed nginx or Apache.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The end of the package manager's output."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/logs": {
      "get": {
        "summary": "Log files",
        "description": "The files in each installed server's log folder.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paths with their size."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/log": {
      "get": {
        "summary": "The end of a log",
        "description": "A file under /var/log, or a server's journal. Access logs also get counts by status, path and client.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "type": "string",
              "enum": [
                "file",
                "journal"
              ]
            }
          },
          {
            "in": "query",
            "name": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "server",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lines",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The lines and counts."
          }
        }
      }
    },
    "/plugin-api/web-servers/{hostId}/watch": {
      "post": {
        "summary": "Get alerts when a web server on this host stops",
        "description": "Checks every minute as the caller and sends one alert when a server stops and one when it runs again.",
        "tags": [
          "Web Servers"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "on": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved."
          }
        }
      }
    }
  },
  "tags": []
}
