{
  "openapi": "3.0.3",
  "info": {
    "title": "Credential Tools API",
    "version": "1.0.0",
    "description": "Generate SSH keys, check them and copy a public key to a host."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/credential-tools/detect-key-type": {
      "post": {
        "summary": "Detect SSH key type",
        "description": "Detects the type of an SSH private key.",
        "tags": [
          "Credential Tools"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "privateKey": {
                    "type": "string"
                  },
                  "keyPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Key type detection result."
          },
          "400": {
            "description": "Private key is required."
          },
          "403": {
            "description": "Not allowed."
          },
          "500": {
            "description": "Failed to detect key type."
          }
        }
      }
    },
    "/plugin-api/credential-tools/detect-public-key-type": {
      "post": {
        "summary": "Detect SSH public key type",
        "description": "Detects the type of an SSH public key.",
        "tags": [
          "Credential Tools"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "publicKey": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Key type detection result."
          },
          "400": {
            "description": "Public key is required."
          },
          "403": {
            "description": "Not allowed."
          }
        }
      }
    },
    "/plugin-api/credential-tools/validate-key-pair": {
      "post": {
        "summary": "Check that an SSH key pair matches",
        "tags": [
          "Credential Tools"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "privateKey": {
                    "type": "string"
                  },
                  "publicKey": {
                    "type": "string"
                  },
                  "keyPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result."
          },
          "400": {
            "description": "A key is missing."
          },
          "403": {
            "description": "Not allowed."
          }
        }
      }
    },
    "/plugin-api/credential-tools/generate-key-pair": {
      "post": {
        "summary": "Generate an SSH key pair",
        "tags": [
          "Credential Tools"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "keyType": {
                    "type": "string",
                    "enum": [
                      "ssh-ed25519",
                      "ssh-rsa",
                      "ecdsa-sha2-nistp256"
                    ]
                  },
                  "keySize": {
                    "type": "integer"
                  },
                  "passphrase": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new key pair."
          },
          "400": {
            "description": "Unsupported key type or size."
          },
          "403": {
            "description": "Not allowed."
          }
        }
      }
    },
    "/plugin-api/credential-tools/generate-public-key": {
      "post": {
        "summary": "Get the public key for a private key",
        "tags": [
          "Credential Tools"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "privateKey": {
                    "type": "string"
                  },
                  "keyPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The public key."
          },
          "400": {
            "description": "The private key could not be read."
          },
          "403": {
            "description": "Not allowed."
          }
        }
      }
    },
    "/plugin-api/credential-tools/credentials/{id}/deploy-to-host": {
      "post": {
        "summary": "Deploy an SSH key to a host",
        "description": "Adds the public key of a saved key credential to the authorized keys of one of your hosts, over SSH. You need to be allowed to view credentials and edit hosts. Every deploy is written to the audit log.",
        "tags": [
          "Credential Tools"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "targetHostId"
                ],
                "properties": {
                  "targetHostId": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSH key deployed."
          },
          "400": {
            "description": "Missing ids or the credential is not a usable key."
          },
          "403": {
            "description": "Not allowed."
          },
          "404": {
            "description": "Credential or target host not found."
          },
          "500": {
            "description": "Failed to deploy the SSH key."
          }
        }
      }
    }
  },
  "tags": []
}
