    "/plugin-api/ai/ops/conversations/{id}/compact": {
      "post": {
        "summary": "Summarise the earlier part of an assistant conversation",
        "description": "What happens on its own once the context is nearly full, on request: one model call summarises all but the most recent steps, and the summary stands in for them from then on. compacted is false when the conversation is too short to gain anything.\n",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "providerId": {
                    "type": "integer"
                  },
                  "model": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
