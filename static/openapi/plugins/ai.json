    "/plugin-api/ai/ops/conversations/{id}/stream": {
      "get": {
        "summary": "Watch the run going on in an assistant conversation",
        "description": "The frames /ops/chat streams. Joining part way, the run's frames so far come first, then it continues live until done. With no run going on the stream is a single done frame, and the stored messages are all there is. Closing it never stops the run.\n",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
