{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Assistant API",
    "version": "1.1.0",
    "description": "An AI assistant that reads your setup and proposes changes for you to approve."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/ai/usage": {
      "get": {
        "summary": "Token usage, for the current user or everyone",
        "description": "Totals for today, 7 and 30 days, then per day, per model and per feature over 30 days. scope=all covers every user and adds a per user breakdown; it needs ai.usage.view_all. offset is the browser's time zone offset in minutes, as getTimezoneOffset gives it, so days are the viewer's own.\n",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "scope",
            "schema": {
              "type": "string",
              "enum": [
                "me",
                "all"
              ]
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The usage summary."
          },
          "403": {
            "description": "Missing ai.use, scope=all without ai.usage.view_all, or the assistant is off.\n"
          }
        }
      }
    },
    "/plugin-api/ai/status": {
      "get": {
        "summary": "Whether the AI assistant is available to this user",
        "description": "Deliberately not behind the AI gate: the frontend calls this to decide whether to render any AI surface at all, and needs a plain answer rather than a 403 when the feature is off.\n",
        "tags": [
          "AI"
        ],
        "responses": {
          "200": {
            "description": "The effective enablement state."
          }
        }
      }
    },
    "/plugin-api/ai/opt-in": {
      "put": {
        "summary": "Turn the assistant on or off for the current user",
        "description": "The same value as the user setting \"enabled\", for the onboarding step and the panel, which set it outside the settings form. Refused while the assistant is off for the whole server.\n",
        "tags": [
          "AI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The user's new choice."
          },
          "400": {
            "description": "enabled is not a boolean."
          },
          "403": {
            "description": "The assistant is off for the whole server."
          }
        }
      }
    },
    "/plugin-api/ai/providers": {
      "get": {
        "summary": "List the user's configured AI providers",
        "tags": [
          "AI"
        ],
        "responses": {
          "200": {
            "description": "Providers, with API keys masked."
          },
          "403": {
            "description": "The AI assistant is not enabled."
          }
        }
      },
      "post": {
        "summary": "Add an AI provider",
        "tags": [
          "AI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "providerType": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "baseUrl": {
                    "type": "string"
                  },
                  "apiKey": {
                    "type": "string"
                  },
                  "defaultModel": {
                    "type": "string"
                  },
                  "modelOverrides": {
                    "type": "object",
                    "description": "Per model id, a contextWindow in tokens that replaces what the provider reports.\n",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "contextWindow": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Provider created."
          },
          "400": {
            "description": "Invalid request body."
          }
        }
      }
    },
    "/plugin-api/ai/providers/{id}": {
      "patch": {
        "summary": "Update an AI provider",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "baseUrl": {
                    "type": "string"
                  },
                  "apiKey": {
                    "type": "string"
                  },
                  "defaultModel": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "modelOverrides": {
                    "type": "object",
                    "description": "Replaces every override. Per model id, a contextWindow in tokens; null or a model left out goes back to what the provider reports.\n",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "contextWindow": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider updated."
          },
          "404": {
            "description": "Provider not found."
          }
        }
      },
      "delete": {
        "summary": "Delete an AI provider",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider deleted."
          },
          "404": {
            "description": "Provider not found."
          }
        }
      }
    },
    "/plugin-api/ai/probe-models": {
      "post": {
        "summary": "List models for a provider that has not been saved yet",
        "description": "Lets the add-provider form fill its model picker before the provider exists, so nobody has to go and look up model names by hand.\n",
        "tags": [
          "AI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "providerType": {
                    "type": "string"
                  },
                  "baseUrl": {
                    "type": "string"
                  },
                  "apiKey": {
                    "type": "string"
                  },
                  "providerId": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model ids, possibly a curated fallback list."
          },
          "400": {
            "description": "Unknown provider type."
          }
        }
      }
    },
    "/plugin-api/ai/providers/{id}/models": {
      "get": {
        "summary": "List models available from a provider",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Model ids."
          },
          "502": {
            "description": "The provider could not be reached."
          }
        }
      }
    },
    "/plugin-api/ai/providers/{id}/context": {
      "get": {
        "summary": "The context window of a provider's models, and where it came from",
        "description": "For the provider's default model, every model with an override, every model the user has called through it, and any named in models. source is override, provider (reported by the provider), guess (from the model's family) or default (128k). refresh asks the provider again instead of using what it said in the last six hours.\n",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "models",
            "schema": {
              "type": "string"
            },
            "description": "More model ids, comma separated."
          },
          {
            "in": "query",
            "name": "refresh",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One entry per model."
          },
          "404": {
            "description": "Provider not found."
          }
        }
      }
    },
    "/plugin-api/ai/conversations": {
      "get": {
        "summary": "List the user's AI conversations",
        "tags": [
          "AI"
        ],
        "responses": {
          "200": {
            "description": "Conversations, newest first."
          }
        }
      }
    },
    "/plugin-api/ai/conversations/{id}": {
      "get": {
        "summary": "Get one conversation with its messages and proposals",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The conversation."
          },
          "404": {
            "description": "Conversation not found."
          }
        }
      },
      "delete": {
        "summary": "Delete a conversation",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation deleted."
          }
        }
      }
    },
    "/plugin-api/ai/chat/stream": {
      "post": {
        "summary": "Send a message and stream the assistant's reply",
        "description": "Server-sent events. Emits conversation, token, tool_call, tool_result, proposal, done and error frames.\n",
        "tags": [
          "AI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "conversationId": {
                    "type": "integer"
                  },
                  "providerId": {
                    "type": "integer"
                  },
                  "model": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "activeTab": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An event stream."
          },
          "400": {
            "description": "Invalid request body."
          }
        }
      }
    },
    "/plugin-api/ai/proposals/{id}/apply": {
      "post": {
        "summary": "Apply a pending proposal",
        "description": "Re-validates the stored payload and applies it as the approving user, through the same core APIs and plugin services a manual action uses.\n",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposal applied."
          },
          "400": {
            "description": "The proposal could not be applied."
          },
          "404": {
            "description": "Proposal not found."
          }
        }
      }
    },
    "/plugin-api/ai/proposals/{id}/mark-run-in-terminal": {
      "post": {
        "summary": "Record that a run_command proposal was executed in an open terminal",
        "description": "For the terminal-docked assistant only. The command is typed into the user's already-open SSH session client-side, not re-run over a pooled connection here; this just marks the proposal applied with the output the client captured, so the card and the /apply path stay in sync without running the command twice.\n",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hostId": {
                    "type": "integer"
                  },
                  "summary": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proposal marked applied."
          },
          "400": {
            "description": "The proposal is not a run_command proposal, or the hostId does not match."
          },
          "404": {
            "description": "Proposal not found."
          }
        }
      }
    },
    "/plugin-api/ai/proposals/{id}/reject": {
      "post": {
        "summary": "Reject a pending proposal",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposal rejected."
          },
          "404": {
            "description": "Proposal not found."
          }
        }
      }
    },
    "/plugin-api/ai/tasks": {
      "get": {
        "summary": "Auto-ops tasks and plans waiting for a decision",
        "description": "tasks are the user's own, newest first. approvals are proposed plans and plans being run that the user may decide on: their own, and everyone's for a holder of ai.ops.use.\n",
        "tags": [
          "AI"
        ],
        "responses": {
          "200": {
            "description": "The tasks and the approvals."
          },
          "403": {
            "description": "Missing ai.use, or the assistant is off."
          }
        }
      }
    },
    "/plugin-api/ai/tasks/preferences": {
      "get": {
        "summary": "The provider, model and language the user's tasks use",
        "tags": [
          "AI"
        ],
        "responses": {
          "200": {
            "description": "The preferences."
          }
        }
      },
      "put": {
        "summary": "Save the provider, model and language for the user's tasks",
        "description": "Fields left out keep their value. language is the user's interface language, which reports are written in.\n",
        "tags": [
          "AI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "providerId": {
                    "type": "integer",
                    "nullable": true
                  },
                  "model": {
                    "type": "string",
                    "nullable": true
                  },
                  "language": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved preferences."
          },
          "400": {
            "description": "Invalid field."
          },
          "404": {
            "description": "Provider not found."
          }
        }
      }
    },
    "/plugin-api/ai/tasks/presets": {
      "get": {
        "summary": "Shipped and saved auto-ops presets, with what is enabled",
        "description": "Each preset lists the automations made from it and whether the shipped version is newer than the one they were made from. automationsAvailable is false while the Automations plugin is not running, and presets cannot be enabled then.\n",
        "tags": [
          "AI"
        ],
        "responses": {
          "200": {
            "description": "Presets."
          },
          "403": {
            "description": "Missing ai.ops.use, or the assistant is off."
          }
        }
      }
    },
    "/plugin-api/ai/tasks/presets/{presetId}/enable": {
      "post": {
        "summary": "Create an automation from a preset",
        "description": "Creates it through automations.access as the user: the preset's trigger with the user's changes and one ai_task step. The preset version is recorded so a newer one can be offered later.\n",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "presetId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The automation's name. Defaults to \"AI · \" and the title.\n"
                  },
                  "title": {
                    "type": "string",
                    "description": "The report title. Defaults to the preset's title in the user's language.\n"
                  },
                  "description": {
                    "type": "string"
                  },
                  "trigger": {
                    "type": "object"
                  },
                  "hostSelector": {
                    "type": "object"
                  },
                  "autonomy": {
                    "type": "string",
                    "enum": [
                      "report",
                      "propose"
                    ]
                  },
                  "runbook": {
                    "type": "string"
                  },
                  "maxRunSeconds": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The automation was created."
          },
          "400": {
            "description": "Invalid changes, or Automations refused them."
          },
          "403": {
            "description": "Missing ai.ops.use, or the assistant is off."
          },
          "404": {
            "description": "Preset not found."
          },
          "503": {
            "description": "The Automations plugin is not running."
          }
        }
      }
    },
    "/plugin-api/ai/tasks/custom-presets": {
      "post": {
        "summary": "Save an auto-ops configuration as a preset",
        "description": "shared makes it a preset for everyone who may use auto-ops; only its creator can delete it.\n",
        "tags": [
          "AI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "shared": {
                    "type": "boolean"
                  },
                  "config": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The saved preset."
          },
          "400": {
            "description": "Missing name or an unusable config."
          },
          "403": {
            "description": "Missing ai.ops.use, or the assistant is off."
          }
        }
      }
    },
    "/plugin-api/ai/tasks/custom-presets/{id}": {
      "delete": {
        "summary": "Delete a preset the user saved",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted."
          },
          "404": {
            "description": "Not found, or saved by someone else."
          }
        }
      }
    },
    "/plugin-api/ai/tasks/{id}": {
      "get": {
        "summary": "One auto-ops task with its report and plan",
        "description": "Visible to its owner and to holders of ai.ops.use. canDecide says whether the user may approve or reject its plan.\n",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The task."
          },
          "404": {
            "description": "Task not found."
          }
        }
      }
    },
    "/plugin-api/ai/tasks/{id}/approve": {
      "post": {
        "summary": "Approve a proposed plan and run it",
        "description": "The owner, or a holder of ai.ops.use who can connect to every host in the plan, may approve. The plan then runs as the owner, verbatim, per host in order, stopping a host at its first failure, then its verify commands. Answers at once; poll the task for progress.\n",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Approved; the plan is running."
          },
          "403": {
            "description": "Not allowed to decide on this plan."
          },
          "404": {
            "description": "Task not found."
          },
          "409": {
            "description": "Not waiting for a decision, expired, or auto-ops is paused.\n"
          }
        }
      }
    },
    "/plugin-api/ai/tasks/{id}/reject": {
      "post": {
        "summary": "Reject a proposed plan",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rejected; nothing ran."
          },
          "403": {
            "description": "Not allowed to decide on this plan."
          },
          "404": {
            "description": "Task not found."
          },
          "409": {
            "description": "Not waiting for a decision."
          }
        }
      }
    },
    "/plugin-api/ai/ops/fleets": {
      "get": {
        "summary": "The user's fleets with their member host ids",
        "description": "For the assistant's target picker. available is false while the fleets plugin is not running or the user may not read fleets.\n",
        "tags": [
          "AI"
        ],
        "responses": {
          "200": {
            "description": "Fleets and whether the fleets plugin is available."
          },
          "403": {
            "description": "Missing ai.use, or the assistant is off."
          }
        }
      }
    },
    "/plugin-api/ai/ops/conversations": {
      "get": {
        "summary": "The assistant's conversations, newest first",
        "description": "Shared by the floating assistant and the AI tab.\n",
        "tags": [
          "AI"
        ],
        "responses": {
          "200": {
            "description": "Conversations with their targets, the tokens each has used and whether a run is going on in it.\n"
          },
          "403": {
            "description": "Missing ai.use, or the assistant is off."
          }
        }
      }
    },
    "/plugin-api/ai/ops/conversations/{id}": {
      "get": {
        "summary": "One assistant conversation with its messages and targets",
        "tags": [
          "AI"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The conversation, with the tokens it has used, how much of the model's context its latest call took and whether a run is going on in it.\n"
          },
          "404": {
            "description": "Conversation not found."
          }
        }
      },
      "delete": {
        "summary": "Delete an assistant conversation and its run records",
