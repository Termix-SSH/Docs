    "/plugin-api/ai/ops/conversations/{id}/stop": {
      "post": {
        "summary": "Stop the run going on in an assistant conversation",
        "description": "Ends the model call and any command or CLI call it has running, and answers once the run has ended. stopped is false when there was none.\n",
