{
  "openapi": "3.0.3",
  "info": {
    "title": "Storage Health API",
    "version": "1.0.0",
    "description": "Watch drive and array health over SSH: SMART, NVMe, ZFS, mdadm, btrfs and LVM, with history, alerts and self tests."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/storage-health/summary": {
      "get": {
        "summary": "Health of every host the user can see",
        "description": "Uses the readings the background timer already took, so it never opens an SSH connection.",
        "responses": {
          "200": {
            "description": "One row per watched host."
          }
        }
      }
    },
    "/plugin-api/storage-health/{hostId}": {
      "get": {
        "summary": "Drives, pools, arrays and volumes on a host",
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The latest reading, read again when it is older than a minute."
          }
        }
      }
    },
    "/plugin-api/storage-health/{hostId}/refresh": {
      "post": {
        "summary": "Read the host now",
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The new reading."
          }
        }
      }
    },
    "/plugin-api/storage-health/{hostId}/config": {
      "put": {
        "summary": "Change alerts, interval and thresholds for a host",
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The saved settings."
          }
        }
      }
    },
    "/plugin-api/storage-health/{hostId}/history": {
      "get": {
        "summary": "Temperature, wear and hours for one drive over time",
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "device",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "range",
            "schema": {
              "type": "string",
              "enum": [
                "24h",
                "7d",
                "30d"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Points, oldest first."
          }
        }
      }
    },
    "/plugin-api/storage-health/{hostId}/events": {
      "get": {
        "summary": "Problems found and cleared, self tests and scrubs",
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newest first."
          }
        }
      }
    },
    "/plugin-api/storage-health/{hostId}/selftest": {
      "post": {
        "summary": "Start or stop a SMART self test",
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "short",
                      "long",
                      "abort"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "What was done."
          }
        }
      }
    },
    "/plugin-api/storage-health/{hostId}/scrub": {
      "post": {
        "summary": "Start or stop a scrub, or an array check",
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "string"
                  },
                  "stop": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "What was done."
          }
        }
      }
    }
  },
  "tags": []
}
