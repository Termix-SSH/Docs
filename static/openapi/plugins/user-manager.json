{
  "openapi": "3.0.3",
  "info": {
    "title": "Users API",
    "version": "1.0.0",
    "description": "Manage the user accounts, groups, passwords and SSH keys on your hosts."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/user-manager/{hostId}/status": {
      "get": {
        "summary": "User management status on a host",
        "description": "The login user, whether root or passwordless sudo works, the sudo group, the allowed shells and whether useradd is installed.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The status."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/users": {
      "get": {
        "summary": "Users and groups",
        "description": "Every account and group. Password state needs root or passwordless sudo, otherwise it is unknown.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The users and groups."
          }
        }
      },
      "post": {
        "summary": "Create a user",
        "description": "Runs useradd as root. The password is sent to chpasswd on stdin, never on the command line.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "comment": {
                    "type": "string"
                  },
                  "shell": {
                    "type": "string"
                  },
                  "home": {
                    "type": "string"
                  },
                  "createHome": {
                    "type": "boolean"
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sudo": {
                    "type": "boolean"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/users/{name}": {
      "get": {
        "summary": "Last login and SSH keys of a user",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The last login and the keys in authorized_keys."
          }
        }
      },
      "put": {
        "summary": "Change a user's full name, shell or groups",
        "description": "groups replaces the whole list of extra groups.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved."
          }
        }
      },
      "delete": {
        "summary": "Delete a user",
        "description": "Refused for root and the login user. removeHome=1 also deletes the home folder.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "removeHome",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/users/{name}/password": {
      "post": {
        "summary": "Set a user's password",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password"
                ],
                "properties": {
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/users/{name}/lock": {
      "post": {
        "summary": "Lock or unlock an account",
        "description": "Locking turns off the password and expires the account, so SSH keys stop working too. Refused for root and the login user.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "locked": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/users/{name}/expire-password": {
      "post": {
        "summary": "Make a user pick a new password at the next login",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/users/{name}/sudo": {
      "post": {
        "summary": "Give or take sudo rights",
        "description": "Adds the user to the sudo or wheel group, or removes them.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sudo": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/users/{name}/keys": {
      "post": {
        "summary": "Add an SSH key to a user",
        "description": "Appends one public key to ~/.ssh/authorized_keys, owned by the user with mode 600.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The keys after the change."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/users/{name}/keys/{line}": {
      "delete": {
        "summary": "Remove an SSH key from a user",
        "description": "fingerprint must match the key on that line, so a key that moved is never removed by mistake.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "line",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "fingerprint",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The keys after the change."
          },
          "409": {
            "description": "The keys changed since they were read."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/sessions": {
      "get": {
        "summary": "Who is logged in",
        "description": "Current sessions from who and recent logins from last.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The sessions."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/groups": {
      "post": {
        "summary": "Create a group",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/groups/{name}": {
      "delete": {
        "summary": "Delete a group",
        "description": "Refused while it is a user's main group.",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted."
          }
        }
      }
    },
    "/plugin-api/user-manager/{hostId}/groups/{name}/members": {
      "post": {
        "summary": "Add a user to a group or remove them",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user"
                ],
                "properties": {
                  "user": {
                    "type": "string"
                  },
                  "member": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved."
          }
        }
      }
    }
  },
  "tags": []
}
