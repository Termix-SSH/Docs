{
  "openapi": "3.0.3",
  "info": {
    "title": "Virtual Machines API",
    "version": "1.0.0",
    "description": "Create and manage KVM virtual machines on your Linux hosts over SSH with libvirt."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/virtual-machines/images": {
      "get": {
        "summary": "Cloud images a new VM can start from",
        "tags": [
          "Virtual Machines"
        ],
        "responses": {
          "200": {
            "description": "The built-in image list."
          }
        }
      }
    },
    "/plugin-api/virtual-machines/summary": {
      "get": {
        "summary": "VMs on every host you can reach",
        "description": "One cached read per host with Virtual Machines turned on, at most 4 hosts at a time.",
        "tags": [
          "Virtual Machines"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "refresh",
            "schema": {
              "type": "string"
            },
            "description": "Set to 1 to skip the cache."
          }
        ],
        "responses": {
          "200": {
            "description": "One entry per host."
          }
        }
      }
    },
    "/plugin-api/virtual-machines/hosts/{hostId}/status": {
      "get": {
        "summary": "Whether this host can run VMs",
        "description": "Reports libvirt, KVM, the service, and the tools a new VM needs.",
        "tags": [
          "Virtual Machines"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The status."
          }
        }
      }
    },
    "/plugin-api/virtual-machines/hosts/{hostId}/install": {
      "post": {
