{
  "openapi": "3.0.3",
  "info": {
    "title": "Host Metrics API",
    "version": "1.4.0",
    "description": "Live CPU, memory, disk, network and GPU stats, plus tools to manage your hosts."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/host-metrics/export": {
      "get": {
        "summary": "Export layouts, health checks, templates and history",
        "description": "Downloads the acting user's Host Metrics data as JSON. Hosts are matched on import by address, port and user, so the file moves between servers. Only hosts the caller can connect to are included.",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "history",
            "schema": {
              "type": "boolean"
            },
            "description": "Include metric samples and health results."
          },
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "string"
            },
            "description": "Start of the history range (ISO date). Defaults to 30 days before the end."
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "string"
            },
            "description": "End of the history range (ISO date). Defaults to now."
          },
          {
            "in": "query",
            "name": "hostIds",
            "schema": {
              "type": "string"
            },
            "description": "Comma separated host ids. Defaults to every host with data."
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON file."
          },
          "400": {
            "description": "Invalid date range."
          }
        }
      }
    },
    "/plugin-api/host-metrics/import": {
      "post": {
        "summary": "Import layouts, health checks, templates and history",
        "description": "Reads a file made by the export route. Each host is matched by address, port and user among the hosts the caller can connect to; others are skipped. Existing layouts, checks and templates are kept unless overwrite is true. History rows already stored are never duplicated.",
        "tags": [
          "Host Metrics"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "description": "The exported file."
                  },
                  "overwrite": {
                    "type": "boolean"
                  },
                  "history": {
                    "type": "boolean",
                    "description": "Also import history rows. Defaults to true."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Counts of imported, updated, skipped and failed items."
          },
          "400": {
            "description": "Not a Host Metrics export, or too large."
          }
        }
      }
    },
    "/plugin-api/host-metrics/metrics/summary": {
      "get": {
        "summary": "Latest CPU, memory and disk for every host",
        "description": "The newest sample already collected for each host the caller can connect to. It never starts collection, so hosts nobody looked at lately are missing. Feeds the dashboard card.",
        "tags": [
          "Host Metrics"
        ],
        "responses": {
          "200": {
            "description": "One entry per host with a recent sample."
          }
        }
      }
    },
    "/plugin-api/host-metrics/health/summary": {
      "get": {
        "summary": "Latest dashboard health check results for every host",
        "description": "For each host the caller can connect to, the newest stored result of each of the caller's health checks marked to show on the dashboard, and the worst level among them. It reads stored results only and never runs a check.",
        "tags": [
          "Host Metrics"
        ],
        "responses": {
          "200": {
            "description": "One entry per host with at least one dashboard check result."
          },
          "500": {
            "description": "The results could not be read."
          }
        }
      }
    },
    "/plugin-api/host-metrics/metrics/{id}": {
      "get": {
        "summary": "Get host metrics",
        "description": "Returns the latest sample for a host, including CPU, memory, disk, network, processes and system information.",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Host metrics data, or null before the first sample."
          },
          "403": {
            "description": "No access to this host."
          }
        }
      }
    },
    "/plugin-api/host-metrics/metrics/start/{id}": {
      "post": {
        "summary": "Start metrics collection",
        "description": "Opens an SSH connection from the tab, where a TOTP prompt can be answered, and starts collecting metrics for the host.",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metrics collection started, or a TOTP code is required."
          },
          "401": {
            "description": "The host needs a sign-in step first."
          },
          "404": {
            "description": "Host not found."
          },
          "500": {
            "description": "Failed to start metrics collection."
          }
        }
      }
    },
    "/plugin-api/host-metrics/metrics/stop/{id}": {
      "post": {
        "summary": "Stop metrics collection",
        "description": "Closes the tab's connection and drops its viewer, which stops polling when it was the last one.",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "viewerSessionId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Metrics collection stopped."
          }
        }
      }
    },
    "/plugin-api/host-metrics/metrics/connect-totp": {
      "post": {
        "summary": "Submit a TOTP code",
        "description": "Answers the TOTP prompt a metrics connection is waiting on.",
        "tags": [
          "Host Metrics"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sessionId": {
                    "type": "string"
                  },
                  "totpCode": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connected."
          },
          "400": {
            "description": "Missing sessionId or totpCode."
          },
          "401": {
            "description": "TOTP verification failed."
          },
          "404": {
            "description": "TOTP session not found or expired."
          },
          "429": {
            "description": "Too many TOTP attempts."
          }
        }
      }
    },
    "/plugin-api/host-metrics/metrics/heartbeat": {
      "post": {
        "summary": "Keep a metrics viewer alive",
        "description": "A viewer without a heartbeat for two minutes is dropped.",
        "tags": [
          "Host Metrics"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "viewerSessionId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Heartbeat updated."
          },
          "400": {
            "description": "Invalid viewerSessionId."
          },
          "404": {
            "description": "Viewer session not found."
          }
        }
      }
    },
    "/plugin-api/host-metrics/metrics/register-viewer": {
      "post": {
        "summary": "Register a metrics viewer",
        "description": "Starts polling a host while something shows its metrics. Answers skipped instead of failing when the host has no metrics.",
        "tags": [
          "Host Metrics"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hostId": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Viewer registered, or skipped with a reason."
          },
          "400": {
            "description": "Invalid hostId."
          }
        }
      }
    },
    "/plugin-api/host-metrics/metrics/unregister-viewer": {
      "post": {
        "summary": "Unregister a metrics viewer",
        "description": "Drops a viewer. Polling stops with the last one.",
        "tags": [
          "Host Metrics"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hostId": {
                    "type": "integer"
                  },
                  "viewerSessionId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Viewer unregistered."
          },
          "400": {
            "description": "Invalid hostId or viewerSessionId."
          }
        }
      }
    },
    "/plugin-api/host-metrics/metrics/history/{id}": {
      "get": {
        "summary": "Get metrics history",
        "description": "Returns stored CPU, memory, disk and network samples for a host over a range.",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "range",
            "schema": {
              "type": "string",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d",
                "30d"
              ]
            }
          },
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The samples in the range."
          },
          "400": {
            "description": "Invalid range or dates."
          },
          "403": {
            "description": "No access to this host."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/preferences/{id}": {
      "get": {
        "summary": "Get the Host Metrics layout for a host",
        "description": "Returns the current user's saved card layout for the host, or a default layout from the host's enabled widgets when none is saved.",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The layout for this host."
          },
          "403": {
            "description": "No access to this host."
          }
        }
      },
      "post": {
        "summary": "Save the Host Metrics layout for a host",
        "description": "Saves the current user's card layout for the host. For the host's owner it also updates the host's enabled widgets.",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "slots": {
                    "type": "array"
                  },
                  "columns": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Layout saved."
          },
          "400": {
            "description": "Invalid layout."
          },
          "403": {
            "description": "No access to this host."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/layout-templates": {
      "get": {
        "summary": "List the acting user's dashboard layout templates",
        "tags": [
          "Host Metrics"
        ],
        "responses": {
          "200": {
            "description": "Personal named layouts."
          }
        }
      },
      "post": {
        "summary": "Save a personal named dashboard layout template",
        "tags": [
          "Host Metrics"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "layout"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "layout": {
                    "type": "object",
                    "description": "The Host Metrics preferences layout including slots and columns."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved template."
          },
          "400": {
            "description": "Invalid name or layout."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/layout-templates/{id}": {
      "delete": {
        "summary": "Delete a personal template without changing host layouts",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Template deleted."
          },
          "404": {
            "description": "Template not found for this user."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/layout-templates/hosts": {
      "get": {
        "summary": "List accessible hosts by name and folder, without credentials",
        "tags": [
          "Host Metrics"
        ],
        "responses": {
          "200": {
            "description": "Hosts with connect access",
            "matching layout preferences.": null
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/layout-templates/{id}/apply": {
      "post": {
        "summary": "Replace the acting user's layouts on selected accessible hosts",
        "description": "Applies once. No other users, health checks or host sampling settings change.",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "hostIds"
                ],
                "properties": {
                  "hostIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-host success or failure; failed hosts can be retried."
          },
          "400": {
            "description": "Invalid host selection."
          },
          "404": {
            "description": "Template not found for this user."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/managers/top-memory/{id}": {
      "get": {
        "summary": "List the processes using the most memory",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The top processes by memory."
          },
          "400": {
            "description": "Invalid input."
          },
          "403": {
            "description": "No access to the host",
            "or elevation denied.": null
          },
          "500": {
            "description": "The command failed on the host."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/managers/disk-breakdown/{id}": {
      "get": {
        "summary": "List mounted filesystems and their usage",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Size",
            "used and free space per mount.": null
          },
          "400": {
            "description": "Invalid input."
          },
          "403": {
            "description": "No access to the host",
            "or elevation denied.": null
          },
          "500": {
            "description": "The command failed on the host."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/managers/live/{id}": {
      "get": {
        "summary": "Lightweight live CPU, memory, network, process and GPU sample (Linux)",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One live sample",
            "shared per host and reused until the admin minimum interval passes. With ?stream it is read from a held stream per host": null,
            "which on hosts with an NVIDIA or AMD GPU also carries gpu and gpuAt": null,
            "and with ?nowait it answers pending true instead of waiting for the stream's first frames. Includes minIntervalS.": null
          },
          "403": {
            "description": "No access",
            "or live updates are disabled (code LIVE_DISABLED).": null
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/platform/{id}": {
      "get": {
        "summary": "Detect available management tooling on a host",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Platform capabilities (systemd, package manager, certbot, docker)."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/managers/health/{id}": {
      "get": {
        "summary": "Get the host's health checks and their last results",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The configured checks",
            "their interval and results.": null
          },
          "400": {
            "description": "Invalid input."
          },
          "403": {
            "description": "No access to the host",
            "or elevation denied.": null
          },
          "500": {
            "description": "The command failed on the host."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/managers/health/{id}/config": {
      "post": {
        "summary": "Save the host's health checks",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "checks"
                ],
                "properties": {
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "target": {
                          "type": "string"
                        },
                        "port": {
                          "type": "integer"
                        },
                        "path": {
                          "type": "string"
                        },
                        "dashboard": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "intervalSeconds": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved checks."
          },
          "400": {
            "description": "Invalid input."
          },
          "403": {
            "description": "No access to the host",
            "or elevation denied.": null
          },
          "500": {
            "description": "The command failed on the host."
          }
        }
      }
    },
    "/plugin-api/host-metrics/host-metrics/managers/health/{id}/run": {
      "post": {
        "summary": "Run the host's health checks now",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The result of each check."
          },
          "400": {
            "description": "Invalid input."
          },
          "403": {
            "description": "No access to the host",
            "or elevation denied.": null
          },
          "500": {
            "description": "The command failed on the host."
          }
        }
      }
    }
  },
  "tags": []
}
