    "/plugin-api/host-metrics/managers/packages/{id}": {
      "get": {
        "summary": "List upgradable packages and the package manager",
        "tags": [
          "Host Metrics"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The package manager and upgradable packages."
          },
          "400": {
            "description": "Invalid input."
