{
  "openapi": "3.0.3",
  "info": {
    "title": "Audit Tools API",
    "version": "1.2.0",
    "description": "Send the audit log to your SIEM and export it as CSV or NDJSON."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/audit-tools/export": {
      "get": {
        "summary": "Export the audit log",
        "description": "Streams the audit log as CSV or NDJSON, oldest first. Admin only.",
        "tags": [
          "Audit Tools"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "schema": {
              "type": "string",
              "enum": [
                "csv",
                "ndjson"
              ],
              "default": "csv"
            }
          },
          {
            "in": "query",
            "name": "userId",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "action",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "resourceType",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "success",
            "schema": {
              "type": "string",
              "enum": [
                true,
                false
              ]
            }
          },
          {
            "in": "query",
            "name": "startDate",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "endDate",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The audit log file."
          },
          "403": {
            "description": "Not allowed to export."
          },
          "500": {
            "description": "Failed to export the audit log."
          }
        }
      }
    },
    "/plugin-api/audit-tools/chain": {
      "get": {
        "summary": "Last audit log check",
        "description": "Core's last hourly check of the audit log's hash chain, or null before the first one. Needs the export permission.",
        "tags": [
          "Audit Tools"
        ],
        "responses": {
          "200": {
            "description": "The last check."
          },
          "403": {
            "description": "Not allowed."
          }
        }
      }
    },
    "/plugin-api/audit-tools/chain/verify": {
      "post": {
        "summary": "Check the audit log now",
        "description": "Walks the whole hash chain and returns the result with the newest head.",
        "tags": [
          "Audit Tools"
        ],
        "responses": {
          "200": {
            "description": "The check result."
          },
          "403": {
            "description": "Not allowed."
          }
        }
      }
    },
    "/plugin-api/audit-tools/chain/check-head": {
      "post": {
        "summary": "Compare a saved head",
        "description": "Says whether a head saved earlier still matches the audit log and the chain after it holds.",
        "tags": [
          "Audit Tools"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "hash"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "hash": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The comparison."
          },
          "400": {
            "description": "Not a head."
          },
          "403": {
            "description": "Not allowed."
          }
        }
      }
    }
  },
  "tags": []
}
