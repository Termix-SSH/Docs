{
  "openapi": "3.0.3",
  "info": {
    "title": "Uptime API",
    "version": "1.0.0",
    "description": "Watch websites, ports, hosts and services, get alerts when they go down, and publish status pages."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/uptime/push/{token}": {
      "get": {
        "summary": "Report that a job ran, for a push monitor",
        "tags": [
          "Uptime"
        ],
        "security": [],
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            }
          },
          {
            "in": "query",
            "name": "msg",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ping",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recorded"
          },
          "404": {
            "description": "Unknown token"
          }
        }
      },
      "post": {
        "summary": "Report that a job ran, for a push monitor",
        "tags": [
          "Uptime"
        ],
        "security": [],
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recorded"
          },
          "404": {
            "description": "Unknown token"
          }
        }
      }
    },
    "/plugin-api/uptime/status/{slug}": {
      "get": {
        "summary": "A published status page as HTML",
        "tags": [
          "Uptime"
        ],
        "security": [],
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The page"
          },
          "404": {
            "description": "No such published page"
          }
        }
      }
    },
    "/plugin-api/uptime/status/{slug}/data": {
      "get": {
        "summary": "A published status page as JSON",
        "tags": [
          "Uptime"
        ],
        "security": [],
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Names, states and uptime numbers"
          },
          "404": {
            "description": "No such published page"
          }
        }
      }
    },
    "/plugin-api/uptime/summary": {
      "get": {
        "summary": "Totals for the monitors the user can see",
        "tags": [
          "Uptime"
        ],
        "responses": {
