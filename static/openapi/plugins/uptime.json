            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new monitor. A push monitor's URL is only in this answer"
          },
          "400": {
            "description": "Bad input"
          },
          "403": {
            "description": "A private address or a host the user can't use"
          }
        }
      }
    },
