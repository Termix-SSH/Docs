            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hostIds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "How many were added"
