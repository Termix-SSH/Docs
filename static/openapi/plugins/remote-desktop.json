{
  "openapi": "3.0.3",
  "info": {
    "title": "Remote Desktop API",
    "version": "1.4.0",
    "description": "RDP, VNC, Apple Remote Desktop, RustDesk and Telnet sessions in your browser, with clipboard, file transfer, sharing and recording."
  },
  "servers": [
    {
      "url": "{server}",
      "description": "Your Termix server",
      "variables": {
        "server": {
          "default": "https://termix.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Session token sent in the Authorization header as Bearer and the token."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "Session JWT cookie set at sign-in. When present, it takes precedence over the Authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key starting with tmx_",
        "description": "API key sent in the Authorization header as Bearer and the key, which starts with tmx_. It acts as the key owner and cannot act as anyone else."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/plugin-api/remote-desktop/live-sessions": {
      "get": {
        "summary": "List my open remote desktop sessions",
        "description": "The caller's RDP, VNC and Telnet sessions that are open on the server now.",
        "tags": [
          "Remote Desktop"
        ],
        "responses": {
          "200": {
            "description": "The open sessions, newest first."
          },
          "401": {
            "description": "Not signed in."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/connection/{connectId}": {
      "get": {
        "summary": "Look up guacd's id for a session",
        "description": "Returns the guacamole connection id for a connect request, once guacd has opened it. Only the session's owner gets an answer.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "connectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The id, or null while guacd has not opened the session."
          },
          "401": {
            "description": "Not signed in."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/sessions/{sessionId}/recording": {
      "get": {
        "summary": "Whether a session can be recorded and is recording",
        "description": "For the user who opened the session. available is false when Session Recording is off or the session does not run in the built-in engine.\n",
        "tags": [
          "Remote Desktop"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "available, recording, and forced when an admin made recording required."
          },
          "401": {
            "description": "Not signed in."
          }
        }
      },
      "post": {
        "summary": "Start or stop recording a session",
        "description": "Only the user who opened the session. A recording started partway through begins with the current screen.",
        "tags": [
          "Remote Desktop"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "on"
                ],
                "properties": {
                  "on": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Whether it is recording now."
          },
          "400": {
            "description": "on is missing."
          },
          "403": {
            "description": "Not the session owner."
          },
          "404": {
            "description": "No such session in the built-in engine, or Session Recording is off."
          },
          "409": {
            "description": "Recording is required on this host, so it can't be stopped."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/token": {
      "post": {
        "summary": "Mint a connection token for an address",
        "description": "Creates an encrypted guacamole-lite token for connection details the caller supplies, used by Quick Connect. No saved host is involved.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "hostname"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "rdp",
                      "vnc",
                      "ard",
                      "telnet",
                      "rustdesk"
                    ]
                  },
                  "hostname": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  },
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The encrypted token."
          },
          "400": {
            "description": "Missing or invalid fields."
          },
          "403": {
            "description": "Remote Desktop is turned off."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/connect-host/{hostId}": {
      "post": {
        "summary": "Mint a connection token for a saved host",
        "description": "Resolves the host's RDP, VNC, ARD or Telnet login for the caller (a shared recipient gets only what was shared with them), opens a jump tunnel when the host has jump hosts, and returns an encrypted guacamole-lite token.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "protocol": {
                    "type": "string",
                    "enum": [
                      "rdp",
                      "vnc",
                      "ard",
                      "telnet",
                      "rustdesk"
                    ]
                  },
                  "promptedUsername": {
                    "type": "string"
                  },
                  "promptedPassword": {
                    "type": "string"
                  },
                  "promptedDomain": {
                    "type": "string"
                  },
                  "promptedCode": {
                    "type": "string",
                    "description": "A RustDesk 2FA code."
                  },
                  "rustdeskCodecs": {
                    "type": "string",
                    "description": "Video codecs the browser can decode, like vp9,av1,vp8."
                  },
                  "tabInstanceId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The token and the id to look the session up by."
          },
          "400": {
            "description": "Invalid host id, or the protocol is off for this host."
          },
          "403": {
            "description": "Remote Desktop is turned off."
          },
          "404": {
            "description": "Host not found or no access."
          },
          "500": {
            "description": "The tunnel or the token could not be set up."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/guacd-host/{hostId}": {
      "get": {
        "summary": "Read a host's guacd address",
        "description": "Returns the guacd address an admin set for this host, if any, and whether the caller may change it.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The address (empty when the host uses the global guacd) and canEdit."
          },
          "400": {
            "description": "Invalid host ID."
          },
          "404": {
            "description": "Host not found."
          }
        }
      },
      "put": {
        "summary": "Set a host's guacd address",
        "description": "Sets or clears the guacd address this host's sessions use. Admins only, since it decides where the server opens a connection.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hostname": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved. Empty values clear it."
          },
          "400": {
            "description": "Invalid host ID."
          },
          "403": {
            "description": "Not an admin."
          },
          "404": {
            "description": "Host not found or no edit access."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/status": {
      "get": {
        "summary": "Remote Desktop status",
        "description": "Whether Remote Desktop is turned on, which engine runs sessions (builtin or guacd), and with guacd whether it answers at the configured address. The built-in engine always reports a connected guacd so older clients still connect.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "probe",
            "schema": {
              "type": "string"
            },
            "description": "Set to 0 to skip dialing guacd."
          },
          {
            "in": "query",
            "name": "hostId",
            "schema": {
              "type": "integer"
            },
            "description": "Saved host whose guacd settings should be checked; requires protocol and access to that host."
          },
          {
            "in": "query",
            "name": "protocol",
            "schema": {
              "type": "string",
              "enum": [
                "rdp",
                "vnc",
                "ard",
                "telnet",
                "rustdesk"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The status."
          },
          "500": {
            "description": "The check failed."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/native-rdp": {
      "get": {
        "summary": "Whether the native RDP client can be opened",
        "description": "True only in the Windows desktop app.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Availability."
          }
        }
      },
      "post": {
        "summary": "Open the native RDP client",
        "description": "Opens the operating system's own RDP client (mstsc) for an address. The password is never passed; the client asks for it. Windows desktop app only.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "host"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  },
                  "username": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Whether the client opened."
          },
          "400": {
            "description": "Missing host."
          },
          "404": {
            "description": "Not running in the desktop app."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/moonlight/status": {
      "get": {
        "summary": "Check the Moonlight Web server",
        "description": "Says whether a Moonlight Web server is set up and the saved login works. Never returns the login.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Whether it is configured and reachable, and why not."
          },
          "403": {
            "description": "Remote Desktop is turned off."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/moonlight/hosts": {
      "get": {
        "summary": "List Moonlight Web PCs",
        "description": "Lists the Sunshine PCs the saved Moonlight Web login can see.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The PCs with their pairing state."
          },
          "403": {
            "description": "Remote Desktop is turned off."
          },
          "409": {
            "description": "Moonlight Web is not set up."
          },
          "502": {
            "description": "Moonlight Web could not be reached or refused the login."
          }
        }
      },
      "post": {
        "summary": "Add a Sunshine PC to Moonlight Web",
        "description": "Adds the PC as a global host so every Moonlight Web user can stream it. A PC already there is reused.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The PC."
          },
          "400": {
            "description": "Missing or invalid address or port."
          },
          "403": {
            "description": "Remote Desktop is turned off or the caller may not set up Moonlight."
          },
          "409": {
            "description": "Moonlight Web is not set up."
          },
          "502": {
            "description": "Moonlight Web could not be reached or refused the request."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/moonlight/hosts/{id}/apps": {
      "get": {
        "summary": "List the apps of a Moonlight Web PC",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The apps Sunshine offers."
          },
          "400": {
            "description": "Invalid PC id."
          },
          "403": {
            "description": "Remote Desktop is turned off."
          },
          "409": {
            "description": "Moonlight Web is not set up."
          },
          "502": {
            "description": "Moonlight Web could not be reached or the PC is not paired."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/moonlight/hosts/{id}/pair": {
      "post": {
        "summary": "Start pairing a Moonlight Web PC",
        "description": "Returns a PIN to enter in Sunshine. Poll the pairing job for the result.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job id and PIN."
          },
          "400": {
            "description": "Invalid PC id."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Remote Desktop is turned off or the caller may not set up Moonlight."
          },
          "409": {
            "description": "Moonlight Web is not set up."
          },
          "502": {
            "description": "Moonlight Web could not be reached or refused the request."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/moonlight/pair/{job}": {
      "get": {
        "summary": "Read a pairing job",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "job",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One of waiting, paired, failed or expired."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "No such job for this user."
          }
        }
      }
    },
    "/plugin-api/remote-desktop/moonlight/launch/{hostId}": {
      "post": {
        "summary": "Get the stream address for a host",
        "description": "Checks access and connect policy, then returns the Moonlight Web page to open. The browser signs in to Moonlight Web itself.",
        "tags": [
          "Remote Desktop"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "hostId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The stream address."
          },
          "400": {
            "description": "Invalid host id."
          },
          "403": {
            "description": "No access, Moonlight is off for this host, or recording is required."
          },
          "404": {
            "description": "Host not found."
          },
          "409": {
            "description": "Not set up, not linked, not paired, or the PC is offline."
          },
          "502": {
            "description": "Moonlight Web could not be reached or refused the request."
          }
        }
      }
    }
  },
  "tags": []
}
